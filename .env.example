# Copy this file to .env and adjust values for your environment.

DJANGO_ENV=local
DEBUG=False
SECRET_KEY=change-me

DB_NAME=safetrace
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

STATIC_URL=static/
STATIC_ROOT=/path/to/project/static
MEDIA_URL=media/
MEDIA_ROOT=/path/to/project/medias
MEDIA_HOST=http://localhost:8000
MEDIA_FORCE_HTTPS=False

USE_SENTRY_DNS=False
SENTRY_DNS=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:4000,http://localhost:8000,http://127.0.0.1:4000,http://127.0.0.1,http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:8000,http://127.0.0.1:4000,http://127.0.0.1,http://localhost

PROTECTED_MEDIA_USE_XACCEL=False
PROTECTED_MEDIA_XACCEL_PREFIX=/protected

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

WHISP_API_URL=https://whisp.openforis.org/api
WHISP_API_KEY=change-me

CACHE_STATIC_LAYER=3600
POPPLER_PATH=/usr/bin

EMAIL_NOTIF_ON=True
EMAIL_HOST=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
DEFAULT_RECIPIENTS_ALERT=admin@example.com

GEE_SERVICE_ACCOUNT_EMAIL=pprp-gee@buatin-160113.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=gee_service_account_buatin.json